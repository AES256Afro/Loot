; Engine configuration file.
; Edit through the Godot editor where practical.
; Engine: Godot 4.7.2 stable

config_version=5

[application]

config/name="LOOT: The Living Expanse"
config/description="A hybrid top-down living-world party RPG with first-person procedural dungeons, stopped-time combat, expressive loot, and reactive commentary."
run/main_scene="res://scenes/crawler/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.035, 0.047, 0.064, 1)

[autoload]

GameEvents="*res://scripts/core/event_stream.gd"
Content="*res://scripts/content/content_registry.gd"
Saves="*res://scripts/save/save_service.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=22.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.027, 0.039, 0.055, 1)
